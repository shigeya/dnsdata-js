    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "name": "vscode-jest-tests for dns-data",
            "request": "launch",
            "program": "${workspaceFolder}/packages/dns-data/node_modules/.bin/jest",
            "args": [
                "--runInBand"
            ],
            "cwd": "${workspaceFolder}/packages/dns-data",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "disableOptimisticBPs": true
        }

    ]
}
