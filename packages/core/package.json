{
  "name": "@dnsdata/core",
  "version": "0.4.0",
  "description": "DNS/DNSSEC core data model, wire format, zone parser, and chain verifier",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests"
  },
  "keywords": [
    "dns",
    "dnssec",
    "zone-file",
    "wire-format",
    "rrsig",
    "dnskey",
    "doh",
    "resolver"
  ],
  "author": "Shigeya Suzuki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shigeya/dnsdata-js.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/shigeya/dnsdata-js/issues"
  },
  "homepage": "https://github.com/shigeya/dnsdata-js#readme",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "ts-custom-error": "^3.2.0"
  }
}
