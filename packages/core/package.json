  },
  "bugs": {
    "url": "https://github.com/shigeya/dnsdata-js/issues"
  },
  "homepage": "https://github.com/shigeya/dnsdata-js#readme",
  "devDependencies": {
    "@types/jest": "^26.0.23",
    "eslint": "^7.25.0",
    "jest": "^26.6.3",
    "ts-jest": "^26.5.6",
    "ts-node": "^9.1.1",
    "typescript": "^4.2.4"
  },
  "dependencies": {
    "ts-custom-error": "^3.2.0"
  }
