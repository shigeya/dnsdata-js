{
  "name": "@dnsdata/core",
  "version": "0.0.1",
  "description": "DNS/DNSSEC core data model, wire format, zone parser, and chain verifier",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
